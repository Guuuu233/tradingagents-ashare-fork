<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- DAV-2035 TEMPLATE ONLY — DO NOT INSTALL during 10-13..10-18.
     总控 10-13 令：只交模板，不安装；安装时间 = 10-18 部署后、与定时任务
     检出升级同发布卡。Runs Mon-Fri 20:30 (after the 19:30 tplus5-shadow batch
     and the 19:45 phase2 ledger seal). The wrapper is the only entry point:
     it runs the 1507 progress sheet + the 1950 acceptance generator against
     ~/ta-snapshot/current.db (read-only URI, immutable=1 — see DAV-2033),
     writes ~/ta-work/reports/YYYY-MM-DD/, prunes beyond 30 days, and exits
     non-zero + writes an ALERT file on any failure (never silent).

     Install (after 总控 sign-off):
       cp releases/launchd/ta-daily-reports-wrapper.sh \
          "{{RELEASE_DIR}}/releases/launchd/ta-daily-reports-wrapper.sh"
       chmod +x "{{RELEASE_DIR}}/releases/launchd/ta-daily-reports-wrapper.sh"
       sed "s|{{RELEASE_DIR}}|/Users/davidliu/Documents/TradingAgents-AShare|g" \
          releases/launchd/com.davidliu.ta-daily-reports.plist \
          > ~/Library/LaunchAgents/com.davidliu.ta-daily-reports.plist
       grep -c '{{' ~/Library/LaunchAgents/com.davidliu.ta-daily-reports.plist  # must be 0
       plutil -lint ~/Library/LaunchAgents/com.davidliu.ta-daily-reports.plist
       launchctl bootstrap gui/$UID \
          ~/Library/LaunchAgents/com.davidliu.ta-daily-reports.plist
     Rollback: launchctl bootout gui/$UID/com.davidliu.ta-daily-reports
               && rm -f ~/Library/LaunchAgents/com.davidliu.ta-daily-reports.plist
     (no KeepAlive: a failed report run must not respawn — it writes ALERT and
      waits for the next trading day; respawn would only re-hit the same bug.) -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.davidliu.ta-daily-reports</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{RELEASE_DIR}}/releases/launchd/ta-daily-reports-wrapper.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{RELEASE_DIR}}</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>TA_PYTHON_BIN</key>
        <string>/Users/davidliu/Documents/TradingAgents-AShare/.venv310/bin/python</string>
        <key>TA_PROJECT_ROOT</key>
        <string>{{RELEASE_DIR}}</string>
        <key>TA_SNAPSHOT_DB</key>
        <string>/Users/davidliu/ta-snapshot/current.db</string>
        <key>TA_REPORTS_ROOT</key>
        <string>/Users/davidliu/ta-work/reports</string>
        <key>TA_RETENTION_DAYS</key>
        <string>30</string>
    </dict>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/davidliu/ta-work/reports/_logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/davidliu/ta-work/reports/_logs/launchd.err.log</string>
</dict>
</plist>