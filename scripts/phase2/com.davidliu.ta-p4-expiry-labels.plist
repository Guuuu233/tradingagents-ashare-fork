<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- DAV-2034 — daily expiry-label timer (TEMPLATE ONLY, do not install).
     DAV-2041 — wrapper now sources ~/Documents/TradingAgents-AShare/.env
     itself; keep EnvironmentVariables free of secrets.

     Schedule : Mon-Fri 20:10 (after the 19:45 ledger seal).
     Action   : run_expiry_label_daily.sh — inject credentials from .env,
                trading-day gate, then expiry_label_pipeline.py run + verify
                against the fixed P4 account; append-only under
                work/phase2-labels/.
     Data     : reads the LIVE forward ledger + live market/vendor routes;
                never the snapshot DB (no db flag, no SQLite touch at all).
     Fail     : credential missing / calendar unavailable / run or verify
                non-zero -> alert file + non-zero exit, no retry. A
                non-trading weekday exits 0.

     Path coupling (sync all of these on checkout relocation):
       1) ProgramArguments below  — {{LABELS_DIR}},
       2) WorkingDirectory below   — {{LABELS_DIR}},
       3) TA_CODE_DIR below        — {{LABELS_DIR}} (the pipeline script
          lives in the SAME checkout as this wrapper; if the two ever
          differ, TA_CODE_DIR must point at the one holding
          scripts/phase2/expiry_label_pipeline.py),
       4) TA_ENV_FILE below (independent of the checkout path).

     Install (inside the release card):
       # 1. the checkout that holds run_expiry_label_daily.sh AND
       #    expiry_label_pipeline.py — ONE directory, no drift:
       LABELS_DIR=/Users/davidliu/ta-p4-labels-<sha>
       git clone <repo> "${LABELS_DIR}"
       git -C "${LABELS_DIR}" checkout <sha>
       #    sanity: the pipeline script MUST exist there, else the timer
       #    exits 11 at 20:10 (this is exactly how 2026-10-20 15:56 failed)
       test -f "${LABELS_DIR}/scripts/phase2/expiry_label_pipeline.py" || exit 1
       # 2. credential copy OUTSIDE ~/Documents (launchd /bin/bash is
       #    TCC-denied reads there): dir 700, file 600, never a bare `cp`.
       scripts/phase2/ta_secrets_install.sh          # install
       scripts/phase2/ta_secrets_install.sh check    # strict preflight
       # 3. install the plist with the placeholders resolved:
       sed -e "s|{{LABELS_DIR}}|${LABELS_DIR}|g" \
           scripts/phase2/com.davidliu.ta-p4-expiry-labels.plist \
           > ~/Library/LaunchAgents/com.davidliu.ta-p4-expiry-labels.plist
       # every placeholder must be resolved. The check looks at the VALUES
       # only (the comment lines that NAME the placeholder are skipped).
       # DAV-2292 🟢-3: `grep -c` returns 1 when the COUNT IS 0 — i.e. it
       # returns FAILURE exactly when the check PASSES, so reusing it in a
       # `set -e` / `&&` chain would judge a good plist as broken. Use
       # `grep -q` (success = found = bad) and invert the test:
       ! plutil -extract ProgramArguments json -o - \
          ~/Library/LaunchAgents/com.davidliu.ta-p4-expiry-labels.plist | grep -q 'LABELS_DIR' \
          || { echo "unresolved placeholder in ProgramArguments"; exit 1; }
       ! plutil -extract EnvironmentVariables json -o - \
          ~/Library/LaunchAgents/com.davidliu.ta-p4-expiry-labels.plist | grep -q 'LABELS_DIR' \
          || { echo "unresolved placeholder in EnvironmentVariables"; exit 1; }
       plutil -lint ~/Library/LaunchAgents/com.davidliu.ta-p4-expiry-labels.plist
       launchctl bootstrap gui/$UID \
          ~/Library/LaunchAgents/com.davidliu.ta-p4-expiry-labels.plist
       launchctl kickstart -k gui/$UID/com.davidliu.ta-p4-expiry-labels   # one manual run
     Remove:
       launchctl bootout gui/$UID/com.davidliu.ta-p4-expiry-labels
       rm ~/Library/LaunchAgents/com.davidliu.ta-p4-expiry-labels.plist

     DAV-2284 — TA_ENV_FILE: launchd does NOT expand `~`, `$HOME` or any
     variable in EnvironmentVariables, so the value below MUST stay a
     literal absolute path. It points at a 600 copy in a 700 dir outside
     ~/Documents because macOS refuses launchd-spawned /bin/bash ANY read
     under ~/Documents (measured 2026-10-19: grep and `source` both
     "Operation not permitted" -> a misleading "TUSHARE_TOKEN missing",
     exit 13). Nothing secret lives in this file. Rotating a key means
     updating BOTH ~/Documents/TradingAgents-AShare/.env and the copy —
     see releases/launchd/TA_ENV_TCC.md and the RESTART.md block it ships.

     DAV-2303 (总控 10-20 17:20 令) — no hard-coded checkout any more:
     every path that used to be baked into the shell script now comes from
     this plist (TA_CODE_DIR) or from the script's own location, so moving
     the checkout is a plist-level change, never a code change. The
     2026-10-20 15:56 failure (exit 11) was exactly this: the script still
     pointed at ta-p4-ef8aa9d9, a checkout with no expiry_label_pipeline.py.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.davidliu.ta-p4-expiry-labels</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{LABELS_DIR}}/scripts/phase2/run_expiry_label_daily.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{LABELS_DIR}}</string>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- DAV-2303: the checkout that holds expiry_label_pipeline.py.
             Must be the SAME checkout as ProgramArguments above. -->
        <key>TA_CODE_DIR</key>
        <string>{{LABELS_DIR}}</string>
        <!-- DAV-2303: the interpreter (independent venv, NOT the in-checkout
             .venv310 — 总控 10-17 令迁离 + ~/Documents 位于 TCC 墙后). -->
        <key>TA_PYTHON</key>
        <string>/Users/davidliu/ta-venv/py310/bin/python</string>
        <!-- DAV-2284: absolute literal path — launchd does not expand ~ here.
             600 file in a 700 dir, outside ~/Documents (TCC). No secret. -->
        <key>TA_ENV_FILE</key>
        <string>/Users/davidliu/ta-secrets/ta.env</string>
        <!-- DAV-2292 🟡-3 (round 4): the production work root, stated
             EXPLICITLY. The wrapper warns when TA_WORK_ROOT is NOT set
             (that means "someone ran this by hand"), and this plist is
             the launchd job — so the job itself must set it, otherwise
             every nightly run logs a bogus "outside launchd" warning. -->
        <key>TA_WORK_ROOT</key>
        <string>/Users/davidliu/ta-p4-2e1e199f/work</string>
        <key>NO_PROXY</key>
        <string>127.0.0.1,localhost,100.64.0.0/10</string>
        <key>no_proxy</key>
        <string>127.0.0.1,localhost,100.64.0.0/10</string>
    </dict>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>10</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/davidliu/ta-p4-2e1e199f/work/phase2-labels/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/davidliu/ta-p4-2e1e199f/work/phase2-labels/launchd.err.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
