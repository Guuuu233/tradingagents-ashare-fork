<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- DAV-2034 — daily expiry-label timer (TEMPLATE ONLY, do not install).
     DAV-2041 — wrapper now sources ~/Documents/TradingAgents-AShare/.env
     itself; keep EnvironmentVariables free of secrets.

     Schedule : Mon-Fri 20:10 (after the 19:45 ledger seal).
     Action   : run_expiry_label_daily.sh — inject credentials from .env,
                trading-day gate, then expiry_label_pipeline.py run + verify
                against the fixed P4 account; append-only under
                work/phase2-labels/.
     Data     : reads the LIVE forward ledger + live market/vendor routes;
                never the snapshot DB (no db flag, no SQLite touch at all).
     Fail     : credential missing / calendar unavailable / run or verify
                non-zero -> alert file + non-zero exit, no retry. A
                non-trading weekday exits 0.

     Install (inside the release card, together with the timer
     checkout upgrade so CODE_DIR contains expiry_label_pipeline.py):
       # DAV-2284 — credential copy OUTSIDE ~/Documents (launchd /bin/bash is
       # TCC-denied reads there): dir 700, file 600, never a bare `cp`.
       scripts/phase2/ta_secrets_install.sh          # install
       scripts/phase2/ta_secrets_install.sh check    # strict preflight
         (DAV-2286 🟢-7: the flag is spelled `check` here, not the
          double-hyphen form, because a double hyphen is illegal inside
          an XML comment and would make this plist un-parseable by strict
          XML parsers (plistlib/libxml2 reject it; plutil tolerates it).
          The script accepts BOTH spellings.)
       cp scripts/phase2/com.davidliu.ta-p4-expiry-labels.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.davidliu.ta-p4-expiry-labels.plist
       launchctl kickstart -k gui/$UID/com.davidliu.ta-p4-expiry-labels   # one manual run
     Remove:
       launchctl bootout gui/$UID/com.davidliu.ta-p4-expiry-labels
       rm ~/Library/LaunchAgents/com.davidliu.ta-p4-expiry-labels.plist

     DAV-2284 — TA_ENV_FILE: launchd does NOT expand `~`, `$HOME` or any
     variable in EnvironmentVariables, so the value below MUST stay a
     literal absolute path. It points at a 600 copy in a 700 dir outside
     ~/Documents because macOS refuses launchd-spawned /bin/bash ANY read
     under ~/Documents (measured 2026-10-19: grep and `source` both
     "Operation not permitted" -> a misleading "TUSHARE_TOKEN missing",
     exit 13). Nothing secret lives in this file. Rotating a key means
     updating BOTH ~/Documents/TradingAgents-AShare/.env and the copy —
     see releases/launchd/TA_ENV_TCC.md and the RESTART.md block it ships.

     Path coupling (sync all of these on checkout relocation):
       1) ProgramArguments below,
       2) WorkingDirectory below,
       3) CODE_DIR inside run_expiry_label_daily.sh (the trading-day gate
          now takes it as argv, so it is declared once),
       4) TA_ENV_FILE below (independent of the checkout path).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.davidliu.ta-p4-expiry-labels</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/davidliu/ta-p4-ef8aa9d9/scripts/phase2/run_expiry_label_daily.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/davidliu/ta-p4-ef8aa9d9</string>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- DAV-2284: absolute literal path — launchd does not expand ~ here.
             600 file in a 700 dir, outside ~/Documents (TCC). No secret. -->
        <key>TA_ENV_FILE</key>
        <string>/Users/davidliu/ta-secrets/ta.env</string>
        <key>NO_PROXY</key>
        <string>127.0.0.1,localhost,100.64.0.0/10</string>
        <key>no_proxy</key>
        <string>127.0.0.1,localhost,100.64.0.0/10</string>
    </dict>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>10</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/davidliu/ta-p4-2e1e199f/work/phase2-labels/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/davidliu/ta-p4-2e1e199f/work/phase2-labels/launchd.err.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
